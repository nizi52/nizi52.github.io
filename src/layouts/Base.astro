---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ui, type Lang } from '../data/content';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altPath: string;
  homePath: string;
}

const { lang, title, description, altPath, homePath } = Astro.props;
const t = ui[lang];
const other = lang === 'ru' ? 'en' : 'ru';
const pageTitle = title ?? t.metaTitle;
const pageDescription = description ?? t.metaDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(altPath, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        var theme = 'dark';
        try { theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; } catch (e) {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only z-30 bg-accent px-4 py-2 text-bg focus:not-sr-only focus:fixed focus:left-2 focus:top-2">{lang === 'ru' ? 'к содержимому' : 'skip to content'}</a>
    <header class="fixed inset-x-0 top-0 z-20 border-b border-line bg-bg">
      <div class="wrap flex h-14 items-center justify-between">
        <nav class="flex w-full items-center gap-5 text-sm md:gap-8" aria-label="main">
          <a class="hidden hover:text-accent-text sm:inline" href={`${homePath}#works`}>{t.nav.works}</a>
          <a class="hidden hover:text-accent-text sm:inline" href={`${homePath}#about`}>{t.nav.about}</a>
          <a class="hidden hover:text-accent-text sm:inline" href={`${homePath}#contact`}>{t.nav.contact}</a>
          <ThemeToggle label={lang === 'ru' ? 'сменить тему' : 'toggle theme'} />
          <a class="inline-flex size-11 items-center justify-center rounded-full border border-line hover:border-accent-text hover:text-accent-text" href={altPath} hreflang={other} lang={other}>{t.switchTo}</a>
        </nav>
      </div>
    </header>

    <main id="main" class="pt-14">
      <slot />
    </main>

    <footer class="border-t border-line py-8 text-sm text-muted">
      <div class="wrap">
        <span>nizi, {new Date().getFullYear()}</span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        var paint = function () { if (meta) meta.setAttribute('content', root.dataset.theme === 'light' ? '#a8c2de' : '#0b1020'); };
        paint();
        document.getElementById('theme-toggle').addEventListener('click', function () {
          var next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          paint();
        });
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
